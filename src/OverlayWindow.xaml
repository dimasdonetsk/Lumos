<Window x:Class="Lumos.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumos"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <Geometry x:Key="BoltGeometry">M13.5,2 L4.5,13.5 L11,13.5 L9.5,22 L19.5,10 L13,10 Z</Geometry>

        <!-- Іконка статусу: блискавка / перекреслена блискавка / трикутник зі знаком оклику -->
        <DataTemplate x:Key="StatusIcon">
            <Viewbox>
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource BoltGeometry}" Fill="{Binding StatusBrush}"
                          Visibility="{Binding IconOn, Converter={StaticResource Vis}}"/>
                    <Path Data="{StaticResource BoltGeometry}" Stroke="{Binding StatusBrush}" StrokeThickness="2"
                          StrokeLineJoin="Round" Visibility="{Binding IconOff, Converter={StaticResource Vis}}"/>
                    <Path Data="M3,3 L21,21" Stroke="{Binding StatusBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="{Binding IconOff, Converter={StaticResource Vis}}"/>
                    <Path Data="M12,2.5 L22.5,20.5 L1.5,20.5 Z" Fill="{Binding StatusBrush}" Stroke="{Binding StatusBrush}"
                          StrokeThickness="1.5" StrokeLineJoin="Round"
                          Visibility="{Binding IconAlert, Converter={StaticResource Vis}}"/>
                    <Path Data="M12,9 L12,14.5" Stroke="{DynamicResource Card}" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="{Binding IconAlert, Converter={StaticResource Vis}}"/>
                    <Ellipse Canvas.Left="10.6" Canvas.Top="16.2" Width="2.8" Height="2.8" Fill="{DynamicResource Card}"
                             Visibility="{Binding IconAlert, Converter={StaticResource Vis}}"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HoverFlat" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TabOn}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Тінь малюємо на окремому шарі позаду, щоб текст лишався чітким -->
        <DropShadowEffect x:Key="Shadow" x:Shared="False" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
    </Window.Resources>

    <!-- Зовнішній відступ дає місце тіні -->
    <Grid Margin="16,12,16,20">

        <!-- ЗГОРНУТО: пігулка з іконкою і часом наступної зміни -->
        <Button Style="{StaticResource Flat}" Command="{Binding ExpandCommand}" ToolTip="Показати статус"
                Visibility="{Binding IsPill, Converter={StaticResource Vis}}" HorizontalAlignment="Center">
            <Grid>
            <Border Background="{DynamicResource Card}" CornerRadius="18" Effect="{StaticResource Shadow}"/>
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="18" Height="36" Padding="10,0,14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Width="18" Height="18" Content="{Binding}" ContentTemplate="{StaticResource StatusIcon}"/>
                    <TextBlock Text="{Binding PillText}" Margin="8,0,0,1" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            </Grid>
        </Button>

        <!-- РОЗГОРНУТО: карточка -->
        <Grid Width="400" Visibility="{Binding IsCard, Converter={StaticResource Vis}}">
        <Border Background="{DynamicResource Card}" CornerRadius="16" Effect="{StaticResource Shadow}"/>
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16">
            <StackPanel>
                <Grid>
                    <Button Style="{StaticResource Flat}" Command="{Binding ToggleScheduleCommand}" Padding="18,16,18,14"
                            HorizontalContentAlignment="Stretch" ToolTip="Показати / сховати графік">
                        <StackPanel>
                            <DockPanel Margin="0,0,34,0">
                                <Border Width="46" Height="46" CornerRadius="12" Background="{Binding TileBrush}" DockPanel.Dock="Left">
                                    <ContentControl Width="24" Height="24" Content="{Binding}" ContentTemplate="{StaticResource StatusIcon}"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="{Binding StatusBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="13" Margin="0,2,0,0" Foreground="{DynamicResource Fg2}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                        Visibility="{Binding HasBig, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding BigText}" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource Fg}"
                                           Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Text="{Binding BigLabel}" FontSize="13" Foreground="{DynamicResource Fg2}"
                                           VerticalAlignment="Bottom" Margin="10,0,0,8"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Footer}" FontSize="11.5" Margin="0,14,0,0" Foreground="{DynamicResource Fg3}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource HoverFlat}" Command="{Binding CollapseCommand}" ToolTip="Закрити"
                            Width="30" Height="30" Margin="0,12,12,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="M3.5,3.5 L10.5,10.5 M10.5,3.5 L3.5,10.5" Stroke="{DynamicResource Fg3}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <!-- ГРАФІК -->
                <Border BorderBrush="{DynamicResource Line2}" BorderThickness="0,1,0,0" Padding="18,4,18,18"
                        Visibility="{Binding IsScheduleOpen, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="10" Background="{DynamicResource AlertBg}"
                                Visibility="{Binding IsEmergency, Converter={StaticResource Vis}}">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource AlertFg}"
                                       Text="Діють аварійні відключення. Графік нижче зараз не діє: світло можуть вимкнути будь-коли."/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Flat}" Command="{Binding TodayCommand}" Background="{Binding TodayTabBg}"
                                    Padding="12,7">
                                <TextBlock Text="{Binding TodayTab}" FontSize="13" Foreground="{Binding TodayTabFg}"/>
                            </Button>
                            <Button Style="{StaticResource Flat}" Command="{Binding TomorrowCommand}" Background="{Binding TomorrowTabBg}"
                                    Padding="12,7" Margin="4,0,0,0">
                                <TextBlock Text="{Binding TomorrowTab}" FontSize="13" Foreground="{Binding TomorrowTabFg}"/>
                            </Button>
                        </StackPanel>

                        <!-- Є графік на обраний день -->
                        <StackPanel Visibility="{Binding HasDayData, Converter={StaticResource Vis}}">
                            <Grid Margin="0,8,0,0" Width="362" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding NowLabel}" Margin="{Binding NowLabelMargin}" Width="32"
                                           TextAlignment="Center" HorizontalAlignment="Left" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg}"
                                           Visibility="{Binding NowVisible, Converter={StaticResource Vis}}"/>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="48"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="30" Margin="0.75,0" CornerRadius="2"
                                                    Background="{Binding Brush}" Opacity="{Binding Opacity}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Rectangle Grid.Row="1" Width="2" RadiusX="1" RadiusY="1" HorizontalAlignment="Left"
                                           Margin="{Binding NowLineMargin}" Fill="{DynamicResource Fg}"
                                           Visibility="{Binding NowVisible, Converter={StaticResource Vis}}"/>
                            </Grid>

                            <Grid Width="362" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="10.5"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Grid.Column="0" Text="00"/>
                                <TextBlock Grid.Column="1" Text="03"/>
                                <TextBlock Grid.Column="2" Text="06"/>
                                <TextBlock Grid.Column="3" Text="09"/>
                                <TextBlock Grid.Column="4" Text="12"/>
                                <TextBlock Grid.Column="5" Text="15"/>
                                <TextBlock Grid.Column="6" Text="18"/>
                                <TextBlock Grid.Column="7" Text="21"/>
                                <TextBlock Grid.Column="7" Text="24" HorizontalAlignment="Right"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Intervals}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Line2}" BorderThickness="0,1,0,0" Padding="0,8"
                                                Opacity="{Binding Opacity}">
                                            <DockPanel>
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Chip}"
                                                        VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding Range}" Width="106" Margin="10,0,0,0" FontSize="13.5"
                                                           Foreground="{DynamicResource Fg}" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding Dur}" FontSize="13.5" Foreground="{DynamicResource Fg3}"
                                                           DockPanel.Dock="Right"/>
                                                <TextBlock Text="{Binding Label}" FontSize="13.5" Foreground="{DynamicResource Fg2}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Немає графіка на обраний день -->
                        <Border Margin="0,16,0,0" Padding="16,22" CornerRadius="12" Background="{DynamicResource Soft}"
                                Visibility="{Binding NoDayData, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding NoDayTitle}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                                           Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding NoDayHint}" FontSize="12.5" Margin="0,6,0,0" TextAlignment="Center"
                                           Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Легенда -->
                        <WrapPanel Margin="0,14,0,0">
                            <WrapPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
                                    <Setter Property="Margin" Value="6,0,14,0"/>
                                </Style>
                            </WrapPanel.Resources>
                            <Border Width="8" Height="8" CornerRadius="2" Background="#36C66A"/>
                            <TextBlock Text="Світло є"/>
                            <Border Width="8" Height="8" CornerRadius="2" Background="#F2C14E"/>
                            <TextBlock Text="Планове відключення"/>
                            <Border Width="8" Height="8" CornerRadius="2" Background="#F0574D"/>
                            <TextBlock Text="Аварійне"/>
                        </WrapPanel>

                        <!-- Черги -->
                        <StackPanel Visibility="{Binding HasQueues, Converter={StaticResource Vis}}">
                            <TextBlock Text="ЧЕРГА" Margin="0,18,0,0" FontSize="11.5" Foreground="{DynamicResource Fg3}"/>
                            <ScrollViewer MaxHeight="150" Margin="-2.5,6,-2.5,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Queues}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Flat}" Command="{Binding Pick}" Background="{Binding Bg}"
                                                    Margin="2.5" Padding="0,7" HorizontalContentAlignment="Center">
                                                <TextBlock Text="{Binding Id}" FontSize="13" Foreground="{Binding Fg}"
                                                           FontWeight="{Binding Weight}"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
