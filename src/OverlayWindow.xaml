<Window x:Class="Lumos.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumos"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <Geometry x:Key="BoltGeometry">M13.5,2 L4.5,13.5 L11,13.5 L9.5,22 L19.5,10 L13,10 Z</Geometry>

        <!-- Іконка статусу: блискавка / перекреслена блискавка / трикутник зі знаком оклику -->
        <DataTemplate x:Key="StatusIcon">
            <Viewbox>
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource BoltGeometry}" Fill="{Binding StatusBrush}"
                          Visibility="{Binding IconOn, Converter={StaticResource Vis}}"/>
                    <Path Data="{StaticResource BoltGeometry}" Stroke="{Binding StatusBrush}" StrokeThickness="2"
                          StrokeLineJoin="Round" Visibility="{Binding IconOff, Converter={StaticResource Vis}}"/>
                    <Path Data="M3,3 L21,21" Stroke="{Binding StatusBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="{Binding IconOff, Converter={StaticResource Vis}}"/>
                    <Path Data="M12,2.5 L22.5,20.5 L1.5,20.5 Z" Fill="{Binding StatusBrush}" Stroke="{Binding StatusBrush}"
                          StrokeThickness="1.5" StrokeLineJoin="Round"
                          Visibility="{Binding IconAlert, Converter={StaticResource Vis}}"/>
                    <Path Data="M12,9 L12,14.5" Stroke="{DynamicResource Card}" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="{Binding IconAlert, Converter={StaticResource Vis}}"/>
                    <Ellipse Canvas.Left="10.6" Canvas.Top="16.2" Width="2.8" Height="2.8" Fill="{DynamicResource Card}"
                             Visibility="{Binding IconAlert, Converter={StaticResource Vis}}"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HoverFlat" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TabOn}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Тонка повзунка в кольорах програми: без стрілок, заокруглена, яскравішає при наведенні -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="{TemplateBinding Width}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="T" CornerRadius="2.5" Background="{DynamicResource Fg3}" Opacity="0.4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="Opacity" Value="0.7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="T" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-пігулка: «Черга 3.1 ⌄», «Вимкнули» -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Soft}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Height="30" CornerRadius="15" Padding="12,0,11,0"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource TabOn}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Половинка перемикача «Сьогодні / Завтра» -->
        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Height="28" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тінь малюємо на окремому шарі позаду, щоб текст лишався чітким -->
        <DropShadowEffect x:Key="Shadow" x:Shared="False" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
    </Window.Resources>

    <!-- Зовнішній відступ дає місце тіні -->
    <Grid Margin="16,12,16,20">
        <Grid Width="400">
        <Border Background="{DynamicResource Card}" CornerRadius="16" Effect="{StaticResource Shadow}"/>
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16">
            <StackPanel>

                <!-- СТАТУС -->
                <StackPanel Margin="18,16,16,4">
                    <DockPanel>
                        <Border Width="46" Height="46" CornerRadius="12" Background="{Binding TileBrush}" DockPanel.Dock="Left">
                            <ContentControl Width="24" Height="24" Content="{Binding}" ContentTemplate="{StaticResource StatusIcon}"/>
                        </Border>
                        <Button Style="{StaticResource Pill}" Command="{Binding ToggleQueuesCommand}" DockPanel.Dock="Right"
                                VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Змінити чергу"
                                Visibility="{Binding HasQueues, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding QueueChipText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                                <Path Data="M2,3.5 L5,6.5 L8,3.5" Stroke="{DynamicResource Fg2}" StrokeThickness="1.5" Width="10" Height="10"
                                      Margin="6,1,0,0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="{Binding StatusBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="13" Margin="0,2,0,0" Foreground="{DynamicResource Fg2}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Вибір черги: розкривається під заголовком -->
                    <Border Margin="0,12,0,0" Padding="6" CornerRadius="12" Background="{DynamicResource Soft}"
                            Visibility="{Binding QueuesOpen, Converter={StaticResource Vis}}">
                        <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Queues}" Margin="0,0,2,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Flat}" Command="{Binding Pick}" Background="{Binding Bg}"
                                                Margin="2" Padding="0,6" HorizontalContentAlignment="Center">
                                            <TextBlock Text="{Binding Id}" FontSize="13" Foreground="{Binding Fg}" FontWeight="{Binding Weight}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Скільки триває стан + «Вимкнули» / «Увімкнули» -->
                    <DockPanel Margin="0,14,0,0" Visibility="{Binding HasBigRow, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource Pill}" Command="{Binding ToggleManualCommand}" DockPanel.Dock="Right"
                                VerticalAlignment="Center" Background="Transparent" BorderBrush="{DynamicResource Line}"
                                ToolTip="{Binding ManualTip}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource BoltGeometry}" Stroke="{DynamicResource Fg2}" StrokeThickness="2.2" StrokeLineJoin="Round"/>
                                        <Path Data="M3,3 L21,21" Stroke="{DynamicResource Fg2}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="{Binding ManualIconStrike, Converter={StaticResource Vis}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding ManualButtonText}" FontSize="12.5" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BigText}" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource Fg}"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding BigLabel}" FontSize="13" Foreground="{DynamicResource Fg2}"
                                       VerticalAlignment="Bottom" Margin="10,0,0,8" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- ГРАФІК -->
                <StackPanel Margin="18,14,18,6">
                    <Border Margin="0,0,0,14" Padding="12,10" CornerRadius="10" Background="{DynamicResource AlertBg}"
                            Visibility="{Binding IsEmergency, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource AlertFg}" Text="{Binding EmergencyBanner}"/>
                            <Button Style="{StaticResource Flat}" Command="{Binding OpenPostCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding HasEmergencyPost, Converter={StaticResource Vis}}">
                                <TextBlock Text="Відкрити повідомлення →" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AlertFg}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Перемикач «Сьогодні / Завтра» -->
                    <Border Padding="3" CornerRadius="10" Background="{DynamicResource Soft}">
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource Segment}" Command="{Binding TodayCommand}" Background="{Binding TodayTabBg}">
                                <TextBlock Text="Сьогодні" FontSize="13" Foreground="{Binding TodayTabFg}" FontWeight="{Binding TodayTabWeight}"/>
                            </Button>
                            <Button Style="{StaticResource Segment}" Command="{Binding TomorrowCommand}" Background="{Binding TomorrowTabBg}">
                                <TextBlock Text="Завтра" FontSize="13" Foreground="{Binding TomorrowTabFg}" FontWeight="{Binding TomorrowTabWeight}"/>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <StackPanel Visibility="{Binding HasDayData, Converter={StaticResource Vis}}">
                            <!-- Смуга графіка: суцільні шматки, позначка «зараз», підписи годин під поділками -->
                            <Canvas Width="362" Height="{Binding TimelineHeight}" HorizontalAlignment="Left" Margin="0,12,0,0" ClipToBounds="False">
                                <!-- «Зараз»: підпис-пігулка над смугою -->
                                <Border Canvas.Left="{Binding NowLabelX}" Canvas.Top="0" Width="42" Height="18" CornerRadius="9"
                                        Background="{DynamicResource Fg}"
                                        Visibility="{Binding NowVisible, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding NowLabel}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Card}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                </Border>

                                <!-- Тонка доріжка під шматками, щоб смуга читалась як одне ціле -->
                                <Border Canvas.Left="0" Canvas.Top="24" Width="362" Height="26" CornerRadius="7"
                                        Background="{DynamicResource Soft}"/>

                                <ItemsControl Canvas.Left="0" Canvas.Top="24" Width="362" Height="26" ItemsSource="{Binding Segments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top" Value="0"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width}" Height="26" CornerRadius="{Binding Corners}"
                                                    Background="{Binding Brush}" Opacity="{Binding Opacity}" ToolTip="{Binding Tip}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Лінія «зараз» з обвідкою кольору карточки, щоб не зливалася з шматками -->
                                <Border Canvas.Left="{Binding NowX}" Canvas.Top="18" Width="2" Height="35" CornerRadius="1"
                                        Background="{DynamicResource Fg}"
                                        Visibility="{Binding NowVisible, Converter={StaticResource Vis}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
                                    </Border.Effect>
                                </Border>

                                <!-- Час кожної зміни під смугою -->
                                <ItemsControl Canvas.Left="0" Canvas.Top="50" Width="362" ItemsSource="{Binding TimeLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top" Value="0"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="36" Height="34">
                                                <Rectangle Canvas.Left="{Binding TickOffset}" Canvas.Top="1" Width="1"
                                                           Height="{Binding TickHeight}" Fill="{Binding Brush}" Opacity="0.7"/>
                                                <TextBlock Canvas.Top="{Binding TextTop}" Width="36" Text="{Binding Text}"
                                                           TextAlignment="{Binding Align}" FontSize="10.5" Foreground="{Binding Brush}"
                                                           Typography.NumeralAlignment="Tabular"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>

                        <TextBlock Text="{Binding NextTitle}" Margin="0,6,0,2" FontSize="11.5" Foreground="{DynamicResource Fg3}"/>
                        <ItemsControl ItemsSource="{Binding NextRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line2}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <DockPanel>
                                            <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Chip}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Range}" Width="110" Margin="10,0,0,0" FontSize="13.5"
                                                       Foreground="{DynamicResource Fg}" DockPanel.Dock="Left" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text="{Binding Dur}" FontSize="13.5" Foreground="{DynamicResource Fg3}" DockPanel.Dock="Right"/>
                                            <TextBlock Text="{Binding Label}" FontSize="13.5" Foreground="{DynamicResource Fg2}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding NextEmpty}" FontSize="13" Foreground="{DynamicResource Fg2}" Margin="0,4,0,4"
                                   Visibility="{Binding HasNextEmpty, Converter={StaticResource Vis}}"/>
                    </StackPanel>

                    <!-- Немає графіка на обраний день -->
                    <Border Margin="0,12,0,8" Padding="16,20" CornerRadius="12" Background="{DynamicResource Soft}"
                            Visibility="{Binding NoDayData, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding NoDayTitle}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding NoDayHint}" FontSize="12.5" Margin="0,6,0,0" TextAlignment="Center"
                                       Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Нижній рядок: область · постачальник · оновлено -->
                <Border BorderBrush="{DynamicResource Line2}" BorderThickness="0,1,0,0" Padding="18,10">
                    <TextBlock Text="{Binding Footer}" FontSize="11.5" Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
