<Application x:Class="Lumos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Кольори теми. Значення підміняє Theme.Apply() під час запуску і при перемиканні теми. -->
        <SolidColorBrush x:Key="Card" Color="#0E0E11"/>
        <SolidColorBrush x:Key="Line" Color="#24242A"/>
        <SolidColorBrush x:Key="Line2" Color="#1C1C21"/>
        <SolidColorBrush x:Key="Fg" Color="#F0F0F2"/>
        <SolidColorBrush x:Key="Fg2" Color="#A6A6AE"/>
        <SolidColorBrush x:Key="Fg3" Color="#8E8E96"/>
        <SolidColorBrush x:Key="TabOn" Color="#2B2B32"/>
        <SolidColorBrush x:Key="Soft" Color="#18181C"/>
        <SolidColorBrush x:Key="AlertBg" Color="#3E1B1C"/>
        <SolidColorBrush x:Key="AlertFg" Color="#FFB8B1"/>
    </Application.Resources>
</Application>
