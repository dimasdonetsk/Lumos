<Window x:Class="Lumos.EcoFlowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcoFlow · Lumos"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#0E1A12"/>
            <Setter Property="Background" Value="#36C66A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="22,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="10" Padding="16,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Soft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Height="30" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#36C66A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="b" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#36C66A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,20">
        <Border Background="{DynamicResource Card}" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                CornerRadius="18" Padding="26,22,26,22" MouseLeftButtonDown="OnDrag">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="OnClose" Cursor="Hand" Width="28" Height="28" VerticalAlignment="Top"
                            ToolTip="Закрити">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="8" Background="Transparent">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource Fg3}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource Soft}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Підключити EcoFlow" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource Fg}"/>
                        <TextBlock Text="Заряд станції в картці Lumos і нагадування поставити її на зарядку."
                                   Margin="0,4,0,0" Style="{StaticResource Hint}" FontSize="12.5"/>
                    </StackPanel>
                </DockPanel>

                <!-- Спосіб входу -->
                <Border Margin="0,18,0,0" Padding="3" CornerRadius="10" Background="{DynamicResource Soft}">
                    <UniformGrid Columns="2">
                        <Button x:Name="KeysTab" Content="Ключі розробника" Style="{StaticResource Segment}" Click="OnKeysTab"/>
                        <Button x:Name="LoginTab" Content="Логін EcoFlow" Style="{StaticResource Segment}" Click="OnLoginTab"/>
                    </UniformGrid>
                </Border>

                <!-- Ключі розробника -->
                <StackPanel x:Name="KeysPanel">
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Hint}">
                        <Run Text="Офіційний спосіб. Зареєструйся на"/>
                        <Hyperlink NavigateUri="https://developer-eu.ecoflow.com" RequestNavigate="OnLink" Foreground="#36C66A">developer-eu.ecoflow.com</Hyperlink>
                        <Run Text="тим самим акаунтом, що й у застосунку, і створи ключі в розділі Developer → Access Key. Схвалення може зайняти кілька днів."/>
                    </TextBlock>
                    <TextBlock Text="Access Key" Style="{StaticResource Label}"/>
                    <TextBox x:Name="AccessKeyBox"/>
                    <TextBlock Text="Secret Key" Style="{StaticResource Label}"/>
                    <PasswordBox x:Name="SecretKeyBox"/>
                </StackPanel>

                <!-- Логін застосунку -->
                <StackPanel x:Name="LoginPanel" Visibility="Collapsed">
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Hint}"
                               Text="Працює одразу, тим самим логіном, що й застосунок EcoFlow. Це неофіційний спосіб: EcoFlow може його змінити, тоді переходь на ключі."/>
                    <TextBlock Text="Пошта акаунта EcoFlow" Style="{StaticResource Label}"/>
                    <TextBox x:Name="EmailBox"/>
                    <TextBlock Text="Пароль" Style="{StaticResource Label}"/>
                    <PasswordBox x:Name="PasswordInput"/>
                    <TextBlock Text="Серійний номер станції" Style="{StaticResource Label}"/>
                    <TextBox x:Name="SnBox" CharacterCasing="Upper"/>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Hint}"
                               Text="Застосунок EcoFlow → станція → ⚙ → Інформація про пристрій. Або на наліпці знизу станції. У River 2 Pro починається з R62."/>
                </StackPanel>

                <!-- Кілька станцій на акаунті -->
                <StackPanel x:Name="DevicesPanel" Visibility="Collapsed">
                    <TextBlock Text="Обери станцію" Style="{StaticResource Label}"/>
                    <ItemsControl x:Name="DevicesList"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Margin="0,14,0,0" FontSize="12.5" TextWrapping="Wrap" Visibility="Collapsed"/>

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Hint}"
                           Text="Ключі й пароль зберігаються лише на цьому комп'ютері, зашифровані ключем твого користувача Windows. Lumos передає їх тільки серверам EcoFlow."/>

                <DockPanel Margin="0,20,0,0">
                    <Button x:Name="DisconnectButton" Content="Відключити" Style="{StaticResource Ghost}" DockPanel.Dock="Left"
                            Click="OnDisconnect" Visibility="Collapsed"/>
                    <Button x:Name="ConnectButton" Content="Підключити" Style="{StaticResource Primary}" HorizontalAlignment="Right"
                            Click="OnConnect" IsDefault="True"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
