<Window x:Class="Lumos.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumos встановлено"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#0E1A12"/>
            <Setter Property="Background" Value="#36C66A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="22,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,20">
        <Border Background="{DynamicResource Card}" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                CornerRadius="18" Padding="28,26,28,24" MouseLeftButtonDown="OnDrag">
            <StackPanel>
                <!-- Галочка в зеленому колі -->
                <Border Width="56" Height="56" CornerRadius="28" Background="#2636C66A" HorizontalAlignment="Left">
                    <Path Data="M7,13.5 L11,17.5 L19,8.5" Stroke="#36C66A" StrokeThickness="2.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="26" Height="26" Stretch="Uniform" Margin="2,2,0,0"/>
                </Border>

                <TextBlock Text="Lumos встановлено" Margin="0,18,0,0" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource Fg}"/>
                <TextBlock x:Name="VersionText" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource Fg3}"/>

                <Border Height="1" Background="{DynamicResource Line2}" Margin="0,20,0,18"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="20"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Background" Value="{DynamicResource Soft}"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Margin" Value="0,0,0,0"/>
                        </Style>
                    </Grid.Resources>

                    <Border Grid.Row="0"><TextBlock Text="1" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/></Border>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Step}" Margin="0,0,0,12">
                        <Run Text="Значок-блискавка з’явився біля годинника." Foreground="{DynamicResource Fg}"/>
                        <Run Text="Якщо його не видно, натисни стрілку ^ на панелі завдань і перетягни значок на панель."/>
                    </TextBlock>

                    <Border Grid.Row="1"><TextBlock Text="2" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/></Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Step}" Margin="0,0,0,12">
                        <Run Text="Правий клік по значку → Область і Черга." Foreground="{DynamicResource Fg}"/>
                        <Run Text="Свою чергу можна знайти за адресою на сайті обленерго."/>
                    </TextBlock>

                    <Border Grid.Row="2"><TextBlock Text="3" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/></Border>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Step}">
                        <Run Text="Клік по значку — графік на сьогодні й завтра." Foreground="{DynamicResource Fg}"/>
                        <Run Text="Lumos запускається разом з Windows і оновлюється сам."/>
                    </TextBlock>
                </Grid>

                <Button Content="Готово" Style="{StaticResource Primary}" Margin="0,24,0,0"
                        HorizontalAlignment="Right" Click="OnDone" IsDefault="True" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
